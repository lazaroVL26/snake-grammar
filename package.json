{
  "name": "snake-grammar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Jogo Snake com quiz de Simple Past x Past Perfect para aula de ingles",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.cjs --max-warnings=0",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
